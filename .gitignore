__pycache__/
*.pyc
.venv/
*.egg-info/

# real per-agent config with secrets — only *-example versions are committed
agents/*/config.yaml
!agents/*/config.yaml-example

# per-agent dedupe state written by SeenStore at run time
agents/*/.seen-*.json

# proposals store written by the approval destination (issue #21) when the
# config dir doubles as the workspace; workspaces proper live outside the checkout
agents/*/state/
