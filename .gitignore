__pycache__/
*.pyc
.venv/
*.egg-info/

# Real configs and dedupe state live in workspaces outside the checkout
# (issue #43); only agents/*/config.example.json is committed. These patterns
# keep a stray pre-workspace copy from ever being committed.
agents/*/config.json
agents/*/config.yaml
agents/*/.seen-*.json

# proposals store written by the approval destination (issue #21) when the
# config dir doubles as the workspace; workspaces proper live outside the checkout
agents/*/state/

# Session notes and handoffs (issue #68). Untracked, but NOT ignored before
# this line, so a `git add -A` would have committed them: they describe the
# live deployment -- workspace names, channel ids, launchd labels -- which is
# exactly what must never reach a public repo.
.claude/

# setuptools build tree
build/
