# Copy to config.yaml (gitignored) and fill in real values.
# Secrets never live here: credentials are named by env var, not stored.
agent: release-notes-example
schedule: "0 9 * * 1"

source:
  type: github-releases
  org: "<org>"
  # "public" (default), "private" or "all". Archived repos are always skipped.
  visibility: public
  # "state": window starts at last_run in <state_dir>/github-releases.json,
  # or at first_run_since when there is no state yet. Any ISO date instead of
  # "state" is used literally and leaves the state file alone (hand re-runs).
  since: state
  first_run_since: "2026-01-01"
  include_prereleases: false
  # Forks and mirrors whose releases are not ours to announce.
  exclude_repos:
    - "<fork-we-do-not-own>"
  # Directory holding github-releases.json. Issue #43 will have the CLI inject
  # the workspace's state/ dir here; until then set it explicitly.
  state_dir: "<path-to-agent-state-dir>"

scorer:
  type: regex
  ignore_case: true
  match: presence
  floor: 0
  rules: []

destination:
  type: digest
  webhook_env: SOME_WEBHOOK
  title: "Release notes"
  prompt: |
    Write this week's release notes from the releases below. Group by repo,
    keep each project's own wording where it is good, and skip version bumps
    with no user-visible change.
