# Copy to config.yaml (gitignored) and fill in real values.
# Secrets never live here: credentials are named by env var, not stored.
#
# This is one agent per community workspace. Copy this directory (or just
# this file, renamed) per workspace and give each its own `agent:` name so
# their .seen-*.json dedupe state does not collide.
agent: slack-workspace-example
schedule: "0 */6 * * *"

source:
  type: slack-workspace
  # Two transports (issue #19, #45):
  #   agentmail - the workspace's notification emails, forwarded to AgentMail.
  #   session   - read the channels as the logged-in browser user. See the
  #               second source block at the bottom of this file.
  transport: agentmail

  # Label only, for the Signal's source/meta fields — not a credential.
  # Setup: turn on the workspace's own notification/digest emails (Slack
  # workspace preferences -> Notifications) and forward them to the
  # AgentMail inbox below.
  workspace: "<workspace-label>"

  # AgentMail inbox that receives the forwarded digest emails, and the env
  # var holding its API key. Falls back to AGENTMAIL_EMAIL if 'inbox' is
  # omitted, same as the agentmail source (issue #12).
  inbox: "<agent-inbox>@agentmail.to"
  api_key_env: AGENTMAIL_API_KEY

  # An inbox is often shared across agents (another agent's digests may land
  # in the same one) — scope to this workspace's notification sender so
  # unrelated mail is never scored as a Slack signal.
  from_contains:
    - "<notification-sender-domain>"

  # Coarse, best-effort: AgentMail's message list has no structured channel
  # field, so this matches the channel name against the combined
  # subject+body text. Omit for everything the digest emails cover.
  channels:
    - "#<channel-name>"

  # Bounds how many recent inbox messages are considered per run (not a
  # time window — AgentMail's list endpoint doesn't support one, and the
  # digest emails already arrive on Slack's own cadence).
  limit: 50

scorer:
  type: regex
  ignore_case: true
  match: presence
  floor: 0
  rules:
    - {pattern: "<keyword-worth-flagging>", points: 10}

destination:
  type: slack
  routes:
    - min_score: 10
      webhook_env: SLACK_WORKSPACE_DIGEST_WEBHOOK
      channel: "#<internal-digest-channel>"

# ---------------------------------------------------------------------------
# Alternative source block: transport 'session' (issue #45).
#
# Reads named channels as the user logged in to the workspace in a local
# browser. Credentials are extracted per run from the browser cookie store
# (pycookiecheat, `pip install '.[slack-session]'`) and the workspace page,
# held in memory and dropped at exit; nothing is stored and nothing is
# configured here. On macOS the cookie decryption reads the login keychain
# and may prompt the first time.
#
# Read-only: the client refuses any Slack method outside a fixed allowlist
# (auth.test, conversations.list/history/replies, chat.getPermalink,
# users.info, users.list) before any HTTP. No config key widens it.
#
# source:
#   type: slack-workspace
#   transport: session
#   workspace: "<workspace-label>"
#   # The <subdomain> in <subdomain>.slack.com. Must be a workspace you are
#   # logged in to in the browser named below.
#   subdomain: "<workspace-subdomain>"
#   # pycookiecheat browser name: chrome (default), chromium, brave, firefox, slack.
#   browser: chrome
#   # Channel names (no '#' needed). Resolved to ids per run; an unknown name
#   # raises and lists what the workspace has.
#   channels:
#     - general
#     - introductions
#   # Lookback window for conversations.history. Signal ids are
#   # <channel_id>:<ts>, so overlapping windows dedupe through the SeenStore.
#   since_hours: 24
#   # Fold thread replies into the parent message's text.
#   include_threads: true
